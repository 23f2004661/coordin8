# Coordin8 Environment Configuration Template

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./data/coordin8.db
# DATABASE_URL=postgresql://coordin8:coordin8_pass@localhost:5432/coordin8

# Qdrant Vector Search
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=coordin8

# LLM & Generation (Groq for the MVP; LM Studio is also supported)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=<groq-model>
LLM_TEMPERATURE=0.1

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Unlimited-OCR Microservice (Local) & Cloud Fallback
OCR_BASE_URL=http://127.0.0.1:9001
OCR_PROVIDER=unlimited_ocr
OCR_TIMEOUT_SECONDS=60
# Mistral OCR (Automatic Cloud Fallback if local Unlimited-OCR is unavailable)
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Reranker
RERANKER_PROVIDER=local
RERANKER_MODEL=bge-reranker-large

# Storage Paths
ARTIFACT_ROOT=./data
